{
  "_about": "Temas ajustados ala categoria de la app original (StrategyQuant X, plataforma de generacion de estrategias de trading). Editado por replica-entrepreneur segun permite el skill.",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
    "\\bportfolio level risk management\\b",
    "\\brisk management\\b",
    "\\b(money|capital) management\\b",
    "\\bportfoli(o)\\b",
    "\\bdiversif",
    "\\buncorrelated\\b",
    "\\bcorrelation\\b",
    "\\bpython\\b",
    "\\bAPI\\b",
    "\\bsimpler (alternative|version)\\b",
    "\\bi need\\b",
    "\\bmobile access\\b"
  ],
  "themes": [
    {"id": "overfitting", "label": "Overfitting: strategies that do not survive live", "kind": "complaint",
     "patterns": ["\\boverfit", "\\bover-?optimi[sz]", "\\bcurve-?fitt", "\\bdon'?t generalise?", "\\bwon'?t generalize", "\\bnever really there", "\\bnot predictive", "\\bnon predictive", "\\bnoise\\b"]},
    {"id": "generator-yield", "label": "Generator output: weak or useless strategies", "kind": "complaint",
     "patterns": ["\\bbad strategies\\b", "\\bnot that impressive\\b", "\\bgot rich\\b", "\\bnot even one passed\\b", "\\bfailed to find a single strategy\\b", "\\bgibberish\\b", "\\bgarbage\\b", "\\bdeceives\\b", "\\bnonsens"]},
    {"id": "search-ops", "label": "The engine does not find what you ask for / do not trust WFA", "kind": "complaint",
     "patterns": ["\\bblack box\\b", "\\bgenetic (optimization|side)? ?(is)? ?useless\\b", "\\bi don'?t (really )?know how it works\\b", "\\bsearch process\\b", "\\bexploit the first thing it finds\\b", "\\bsurvive a live period\\b", "\\bsurvive a 1-year forward\\b"]},
    {"id": "export-mismatch", "label": "Exports do not reproduce the same results", "kind": "complaint",
     "patterns": ["\\bresults of the strategies do not match\\b", "\\bexports? can behave differently\\b", "\\bcan'?t run my strategies built in SQ\\b", "\\bfailed with code 1\\b", "\\bdoesn'?t match\\b", "\\bverify every (export|strategy)\\b"]},
    {"id": "code-quality", "label": "Exported code quality", "kind": "complaint",
     "patterns": ["\\bcode it produces\\b", "\\bexports? code\\b", "\\bmql\\b", "\\bsource code\\b"]},
    {"id": "complexity", "label": "Too complex, steep learning curve, too many options", "kind": "complaint",
     "patterns": ["\\blearning curve\\b", "\\btoo many options\\b", "\\bhard to use\\b", "\\bsomewhat undertook to master\\b", "\\bquite an undertaking\\b", "\\bdon'?t understand how to use\\b", "\\bdense\\b", "\\bdated\\b", "\\bstatistically\\b", "\\bcomplex\\b"]},
    {"id": "pricing", "label": "Price, edition gates and lock-in", "kind": "complaint",
     "patterns": ["\\bexpensive\\b", "\\b$\\d", "\\bone year update\\b", "\\blicence for sale\\b", "\\btransfer fee\\b", "\\bupfront\\b", "\\binstallments?\\b", "\\bprice\\b", "\\bcosts?\\b", "\\bpaywall", "\\bfree version\\b", "\\bfree (tier|trial)\\b", "\\bnot worth\\b", "\\b1k\\b"]},
    {"id": "compute", "label": "Needs a beefy machine / slow", "kind": "complaint",
     "patterns": ["\\bcompute\\b", "\\bgood machine\\b", "\\bnvidia\\b", "\\bslow\\b", "\\blaptop\\b", "\\br9-9950x\\b", "\\brequires a good machine\\b"]},
    {"id": "privacy", "label": "Privacy: calls home / no trusting the vendor", "kind": "complaint",
     "patterns": ["\\bcalling home\\b", "\\bsending test results back\\b", "\\bdouble dip\\b", "\\bprivacy\\b", "\\bopen source\\b", "\\btrusting?\\?\\b", "\\bzero trust\\b", "\\bscam\\b"]},
    {"id": "creator-spam", "label": "Affiliate noise around the product", "kind": "complaint",
     "patterns": ["\\bpromo code\\b", "\\bpromotional code\\b", "\\baffiliate\\b", "\\bconveniently give you a promo\\b", "\\bselling the software through"]},
    {"id": "money-mgmt", "label": "Money management hard to configure", "kind": "complaint",
     "patterns": ["\\bmoney management\\b", "\\bcapital management\\b", "\\blo(s|t) sizing\\b", "\\bposition sizing\\b", "\\bscreenshot of that\\b"]},
    {"id": "portfolio", "label": "Want portfolio-level construction and risk", "kind": "request",
     "patterns": ["\\bportfolio level risk management\\b", "\\bportfolio\\b", "\\bdiversif", "\\buncorrelated\\b", "\\bdecorrelation\\b", "\\bcorrelation\\b"]},
    {"id": "live-parity", "label": "Want proof of live/backtest parity", "kind": "request",
     "patterns": ["\\bexecution drift\\b", "\\bdiscrepancy between\\b", "\\bbehind the live\\b", "\\bstate handling\\b", "\\bfee drag\\b", "\\bforward test\\b", "\\blive period\\b"]},
    {"id": "indicators-ml", "label": "Want more indicators / machine learning", "kind": "request",
     "patterns": ["\\blimited number of indicators\\b", "\\bmore indicators\\b", "\\bmachine learning\\b", "\\bML\\b"]},
    {"id": "data", "label": "Data: downloads, quality and import", "kind": "request",
     "patterns": ["\\bquant ?(data )?manager\\b", "\\bdata pack\\b", "\\btick data\\b", "\\bdownload\\b", "\\bimport\\b", "\\bdukascopy\\b", "\\bdata quality\\b"]},
    {"id": "validation-process", "label": "Want validation of the whole search, not just the final strategy", "kind": "request",
     "patterns": ["\\bentire research/search process\\b", "\\beconomic hypothesis\\b", "\\bsearch constraints\\b", "\\bvalidation (pipeline|stage)\\b", "\\bselection process\\b"]}
  ]
}
